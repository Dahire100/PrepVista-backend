# MongoDB Configuration
MONGO_URI=your_MONGO_URI
DB_NAME=prepvista

# JWT Secret Key (Generate a random string)
JWT_SECRET_KEY=your_JWT_SECRET_KEY

# Gemini API Keys (use your existing keys)
# For Hugging Face Spaces: Set these in the Space Settings as environment variables
# GEMINI_API_KEY_1 is used for Interview service
# GEMINI_API_KEY_2 is used for Resume service
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=104857600

# CORS Configuration
FRONTEND_URL=http://localhost:3000
